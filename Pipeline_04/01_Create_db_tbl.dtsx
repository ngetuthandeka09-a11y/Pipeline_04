      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2061ABBE-5B8F-4F3D-A2F2-36AF779DF18A}"
          SQLTask:SqlStatementSource="USE [stg_Db]&#xA;GO&#xA;&#xA;SET ANSI_NULLS ON&#xA;GO&#xA;&#xA;SET QUOTED_IDENTIFIER ON&#xA;GO&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM INFORMATION_SCHEMA.TABLES&#xA;    WHERE TABLE_CATALOG = 'stg_Db'&#xA;      AND TABLE_SCHEMA  = 'bronze'&#xA;      AND TABLE_NAME    = 'retail_sales_dataset'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [bronze].[retail_sales_dataset] (&#xA;        [Transaction ID]   varchar(50),&#xA;        [Date]             varchar(50),&#xA;        [Customer ID]      varchar(50),&#xA;        [Gender]           varchar(50),&#xA;        [Age]              varchar(50),&#xA;        [Product Category] varchar(50),&#xA;        [Quantity]         varchar(50),&#xA;        [Price per Unit]   varchar(50),&#xA;        [Total Amount]     varchar(50)&#xA;    )&#xA;END&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
